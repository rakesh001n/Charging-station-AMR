<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='warehouse_world'>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Warehouse perimeter: 8 m x 7 m, with a clear robot-sized interior. -->
    <model name='warehouse_walls'>
      <static>true</static>
      <link name='walls'>
        <collision name='north_collision'><pose>0 3.45 1.5 0 0 0</pose><geometry><box><size>8 0.15 3</size></box></geometry></collision>
        <collision name='south_collision'><pose>0 -3.45 1.5 0 0 0</pose><geometry><box><size>8 0.15 3</size></box></geometry></collision>
        <collision name='east_collision'><pose>3.95 0 1.5 0 0 0</pose><geometry><box><size>0.15 7 3</size></box></geometry></collision>
        <collision name='west_collision'><pose>-3.95 0 1.5 0 0 0</pose><geometry><box><size>0.15 7 3</size></box></geometry></collision>
        <visual name='north_visual'><pose>0 3.45 1.5 0 0 0</pose><geometry><box><size>8 0.15 3</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient></material></visual>
        <visual name='south_visual'><pose>0 -3.45 1.5 0 0 0</pose><geometry><box><size>8 0.15 3</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient></material></visual>
        <visual name='east_visual'><pose>3.95 0 1.5 0 0 0</pose><geometry><box><size>0.15 7 3</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient></material></visual>
        <visual name='west_visual'><pose>-3.95 0 1.5 0 0 0</pose><geometry><box><size>0.15 7 3</size></box></geometry><material><ambient>0.25 0.28 0.32 1</ambient></material></visual>
      </link>
    </model>

    <!-- Four warehouse rack rows create aisles for the AMR. -->
    <model name='rack_row_north_west'><static>true</static><pose>-1.65 1.55 0 0 0 0</pose><link name='rack'>
      <collision name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>2.1 0.55 1.8</size></box></geometry></collision>
      <visual name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>2.1 0.55 1.8</size></box></geometry><material><ambient>0.12 0.22 0.42 1</ambient><diffuse>0.15 0.30 0.65 1</diffuse></material></visual>
    </link></model>
    <model name='rack_row_north_east'><static>true</static><pose>1.45 1.55 0 0 0 0</pose><link name='rack'>
      <collision name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.45 0.55 1.8</size></box></geometry></collision>
      <visual name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.45 0.55 1.8</size></box></geometry><material><ambient>0.12 0.22 0.42 1</ambient><diffuse>0.15 0.30 0.65 1</diffuse></material></visual>
    </link></model>
    <model name='rack_row_south_west'><static>true</static><pose>-1.65 -0.75 0 0 0 0</pose><link name='rack'>
      <collision name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>2.1 0.55 1.8</size></box></geometry></collision>
      <visual name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>2.1 0.55 1.8</size></box></geometry><material><ambient>0.12 0.22 0.42 1</ambient><diffuse>0.15 0.30 0.65 1</diffuse></material></visual>
    </link></model>
    <model name='rack_row_south_east'><static>true</static><pose>1.45 -0.75 0 0 0 0</pose><link name='rack'>
      <collision name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.45 0.55 1.8</size></box></geometry></collision>
      <visual name='body'><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.45 0.55 1.8</size></box></geometry><material><ambient>0.12 0.22 0.42 1</ambient><diffuse>0.15 0.30 0.65 1</diffuse></material></visual>
    </link></model>

    <!-- Loading zone and pallet stacks. -->
    <model name='loading_zone'><static>true</static><pose>2.9 -2.55 0.006 0 0 0</pose><link name='zone'><visual name='floor'><geometry><box><size>1.5 1.1 0.012</size></box></geometry><material><ambient>0.05 0.35 0.75 1</ambient><diffuse>0.05 0.35 0.75 1</diffuse></material></visual></link></model>
    <!-- Dedicated charging bay. Battery charger coordinates are (-3.2, -2.55). -->
    <model name='charging_port'><static>true</static><pose>-3.2 -2.55 0.012 0 0 0</pose><link name='pad'>
      <visual name='yellow_pad'><geometry><box><size>1.0 0.9 0.02</size></box></geometry><material><ambient>1 0.85 0 1</ambient><diffuse>1 0.85 0 1</diffuse><emissive>0.15 0.1 0 1</emissive></material></visual>
    </link></model>
    <model name='charging_sign'><static>true</static><pose>-3.2 -2.05 1.0 0 0 0</pose><link name='sign'><visual name='board'><geometry><box><size>1.2 0.08 0.7</size></box></geometry><material><ambient>1 0.85 0 1</ambient></material></visual></link></model>
  </world>
</sdf>
