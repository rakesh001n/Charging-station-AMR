<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='patrol_world'>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <model name='charging_port'>
      <static>true</static>
      <pose>0 0 0.012 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><box><size>0.9 0.9 0.02</size></box></geometry>
          <material>
            <ambient>1 0.85 0 1</ambient>
            <diffuse>1 0.85 0 1</diffuse>
            <emissive>0.15 0.1 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <model name='obstacle_box_a'>
      <static>true</static>
      <pose>1.2 0.8 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.2 0.45 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name='obstacle_box_b'>
      <static>true</static>
      <pose>-1.3 -0.9 0.3 0 0 0.35</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>1.0 0.45 0.6</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.0 0.45 0.6</size></box></geometry>
          <material><ambient>0.8 0.35 0.12 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name='obstacle_cylinder'>
      <static>true</static>
      <pose>0 -1.8 0.45 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.2 0.65 0.25 1</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
